<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- نوع خروجی: برنامه ویندوزی (بدون پنجره کنسول) -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>IndustrialSensorMonitor</RootNamespace>
    <AssemblyName>IndustrialSensorMonitor</AssemblyName>

    <!-- پشتیبانی از هدف‌گیری ویندوز حتی در صورت Build روی سیستم‌عامل دیگر (GitHub Actions) -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>

    <!-- نمایش و مقیاس‌پذیری در رزولوشن‌های مختلف -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationDefaultFont>Tahoma, 9.75pt</ApplicationDefaultFont>
    <ApplicationVisualStyles>true</ApplicationVisualStyles>
    <ApplicationUseCompatibleTextRendering>false</ApplicationUseCompatibleTextRendering>

    <!-- آیکون برنامه (داخل فایل اجرایی تعبیه می‌شود) -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>

    <!-- اطلاعات نسخه برنامه (هماهنگ با فایل نصب و GitHub Release) -->
    <Version>1.2.0</Version>
    <AssemblyVersion>1.2.0.0</AssemblyVersion>
    <FileVersion>1.2.0.0</FileVersion>
    <Product>Industrial Sensor Monitor</Product>
    <AssemblyTitle>Industrial Sensor Monitor</AssemblyTitle>
    <Description>سامانه ثبت و مدیریت اطلاعات سنسورهای صنعتی</Description>
    <Company>Industrial Sensor Monitor</Company>
    <Copyright>Copyright © 2026</Copyright>

    <!--
      تنظیمات انتشار در فایل Properties/PublishProfiles/win-x64.pubxml و همچنین
      به‌صورت پارامتر خط فرمان در GitHub Actions تعیین می‌شوند:
      Self-contained + Single File + win-x64 (بدون Trim)
    -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <!-- آیکون برنامه در خروجی کپی نمی‌شود؛ فقط داخل فایل اجرایی تعبیه می‌گردد -->
    <None Update="Assets\app.ico">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!-- فایل تنظیمات باید کنار فایل اجرایی قرار بگیرد و داخل Single File قرار نگیرد -->
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </None>
  </ItemGroup>

</Project>
